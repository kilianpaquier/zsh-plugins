#!/bin/sh
# Code generated by AI (Claude Opus 5.5)

set -eu

# shellcheck disable=SC3040
(set -o pipefail >/dev/null 2>&1) && set -o pipefail

#####################################################################
#
# Logging
#
#####################################################################

red='\033[0;31m'
yellow='\033[0;33m'
blue='\033[0;34m'
no_color='\033[0m'

error() {
  printf "${red}ERROR${no_color} %s\n" "$1" >&2
  return 1
}

warn() {
  printf "${yellow}WARN${no_color} %s\n" "$1"
}

info() {
  printf "${blue}INFO${no_color} %s\n" "$1"
}

#####################################################################
#
# Plaintext
#
#####################################################################

# Prints the starting content of a new file.
# Uses '<name>.example.<ext>' next to the file when present, otherwise a built-in example for the extension.
#
# Globals:
#   file, name, ext
#
# Outputs:
#   The content on stdout.
write_template() {
  example="$(dirname "$file")/${name%.*}.example.$ext"
  if [ -n "$ext" ] && [ -f "$example" ]; then
    cat "$example"
    return
  fi

  case "$ext" in
  env)
    cat << 'EOF'
# Saving and quitting the editor encrypts this file.
API_TOKEN=change-me
EOF
    ;;
  json | jsonc | json5)
    cat << 'EOF'
{
  "username": "example",
  "password": "change-me"
}
EOF
    ;;
  yaml | yml)
    cat << 'EOF'
# Saving and quitting the editor encrypts this file.
username: example
password: change-me
EOF
    ;;
  *)
    cat << 'EOF'
Saving and quitting the editor encrypts this file.
EOF
    ;;
  esac
}

# Fills the plaintext file from the encrypted file, or from write_template when the file is missing.
#
# Globals:
#   file, plaintext
#
# Returns:
#   1 when gpg can't decrypt the file.
decrypt() {
  if [ ! -e "$file" ]; then
    info "'$file' doesn't exist, starting from an example."
    write_template > "$plaintext"
    return
  fi

  gpg --quiet --yes --output "$plaintext" --decrypt "$file" || {
    error "Failed to decrypt '$file'."
    return 1
  }
}

# Encrypts the plaintext into the temporary ciphertext, then moves it over the file.
#
# Globals:
#   file, plaintext, ciphertext
#
# Returns:
#   1 when encryption or the move fails, the file is then left untouched.
encrypt() {
  gpg --quiet --yes --symmetric --cipher-algo AES256 --armor --output "$ciphertext" "$plaintext" || {
    error "Failed to encrypt '$file', left untouched."
    return 1
  }
  mv -f "$ciphertext" "$file" || {
    error "Failed to replace '$file'."
    return 1
  }
  info "Saved '$file'."
}

#####################################################################
#
# Editor
#
#####################################################################

# Opens the plaintext in $VISUAL, $EDITOR or vi.
#
# Globals:
#   plaintext, VISUAL, EDITOR
#
# Returns:
#   The editor exit status.
run_editor() {
  # Deliberate word splitting, so an editor with arguments like 'code --wait' works.
  # shellcheck disable=SC2086
  set -- ${VISUAL:-${EDITOR:-vi}}

  case "$(basename "$1")" in
  # Keeps swap, viminfo, shada, backup and undo files from copying plaintext elsewhere.
  vim | nvim) set -- "$@" -n -i NONE --cmd 'set nobackup nowritebackup noundofile' ;;
  esac

  "$@" "$plaintext"
}

# Checks JSON with jq and YAML with yq.
# A missing checker or another extension accepts the content.
#
# Globals:
#   ext, plaintext
#
# Returns:
#   Non-zero when the content is invalid.
validate() {
  case "$ext" in
  json) ! command -v jq >/dev/null 2>&1 || jq empty "$plaintext" ;;
  yaml | yml) ! command -v yq >/dev/null 2>&1 || yq . "$plaintext" >/dev/null ;;
  esac
}

# Asks a yes/no question on the terminal, yes by default.
#
# Arguments:
#   Question to ask.
#
# Outputs:
#   The question on stderr.
#
# Returns:
#   1 on a no answer or when no terminal is available.
confirm() {
  printf '%s [Y/n] ' "$1" >&2
  read -r answer 2> /dev/null < /dev/tty || return 1
  case "$answer" in
  [nN]*) return 1 ;;
  esac
}

# Runs the editor until the content is valid or the user gives up.
#
# Returns:
#   1 when the editor fails or the user declines to re-open it.
edit_loop() {
  while :; do
    run_editor || {
      error "Editor exited with an error, '$file' left untouched."
      return 1
    }
    validate && return 0
    confirm "Re-open editor?" || {
      error "Invalid content, '$file' left untouched."
      return 1
    }
  done
}

#####################################################################
#
# CLI arguments
#
#####################################################################

file=
help=
name=
ext=

usage() {
  cat << 'EOF'
Usage: gpg-edit [-h] <file>

Edit a passphrase-protected file in your editor. Closing the editor saves it encrypted again.
A missing file is created from '<name>.example.<ext>' when one sits next to it.

Arguments:
  file  Encrypted file to edit, created when missing (e.g. secrets.yaml.gpg, .env.gpg)

Examples:
  # Edit a secret, created when missing
  gpg-edit secrets.yaml.gpg

  # Edit with another editor
  VISUAL='code --wait' gpg-edit .env.gpg

Options:
  -h, --help  Show this help.

Requirements:
  - 'gpg' command (GnuPG) with a pinentry program
  - 'jq' and 'yq' commands (optional) for JSON and YAML checks
EOF
}

# Parses the CLI arguments and derives the inner file name and extension.
#
# Globals:
#   file, help, name, ext (set)
#
# Returns:
#   2 on invalid arguments.
parse_arguments() {
  while [ $# -gt 0 ]; do
    case "$1" in
    -h | --help) usage; help=1; return 0 ;;
    -*) usage; error "Unknown argument '$1'."; return 2 ;;
    *)
      [ -z "$file" ] || {
        usage
        error "Too many arguments."
        return 2
      }
      file=$1
      shift
      ;;
    esac
  done

  [ -n "$file" ] || {
    usage
    error "Missing required file argument."
    return 2
  }

  # Strip the encryption extension so the editor detects the inner file type.
  name=$(basename "$file")
  name=${name%.gpg}
  name=${name%.asc}
  case "$name" in
  *.*) ext=${name##*.} ;;
  esac
}

#####################################################################
#
# Main
#
#####################################################################

tmpdir=
plaintext=
ciphertext=

cleanup() {
  [ -z "$tmpdir" ] || rm -rf "$tmpdir"
  [ -z "$ciphertext" ] || rm -f "$ciphertext"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

required_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    error "Required command '$1' is required but wasn't found. Please install it."
    return 1
  fi
}

# Decrypts, edits and encrypts back the file.
main() {
  parse_arguments "$@" || return $?
  [ -z "$help" ] || return 0
  for cmd in cksum gpg mktemp; do required_command "$cmd" || return $?; done

  # Pinentry needs the terminal device to prompt for the passphrase.
  if [ -z "${GPG_TTY:-}" ] && [ -t 0 ]; then
    GPG_TTY=$(tty)
    export GPG_TTY
  fi

  [ -n "${XDG_RUNTIME_DIR:-}" ] || warn "XDG_RUNTIME_DIR is unset, plaintext goes to '${TMPDIR:-/tmp}' which may be disk-backed."
  # Keeps the decrypted file readable by the current user only.
  umask 077
  tmpdir=$(mktemp -d "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/gpg-edit.XXXXXX")
  plaintext="$tmpdir/$name"

  # Same directory as the file, so the final mv is atomic.
  ciphertext=$(mktemp "$(dirname "$file")/.$(basename "$file").XXXXXX") || {
    error "Failed to create a temporary file next to '$file'."
    return 1
  }
  decrypt || return $?

  before=$(cksum < "$plaintext")
  edit_loop || return $?
  if [ "$before" = "$(cksum < "$plaintext")" ]; then
    info "No changes, '$file' left untouched."
    return 0
  fi

  encrypt || return $?
}

main "$@"
