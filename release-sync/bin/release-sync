#!/bin/sh
# Code generated by AI (Claude Sonnet 5)

set -eu

# shellcheck disable=SC3040
(set -o pipefail >/dev/null 2>&1) && set -o pipefail

#####################################################################
#
# Logging
#
#####################################################################

red='\033[0;31m'
blue='\033[0;34m'
no_color='\033[0m'

error() {
  printf "${red}ERROR${no_color} %s\n" "$1" >&2
  return 1
}

info() {
  printf "${blue}INFO${no_color} %s\n" "$1"
}

#####################################################################
#
# Platforms
#
#####################################################################

urlencode() {
  printf '%s' "$1" | jq -sRr @uri
}

# Runs one action on GitHub. gitlab() takes the same actions on GitLab.
#
# Arguments:
#   repository                                            prints the current directory repository
#   releases <repo>                                       prints release tags, oldest first
#   release <repo> <tag>                                  prints the release as {name, body, date}
#   download <repo> <tag> <dir>                           downloads the release assets into dir
#   create <repo> <tag> <title> <notes> <date> [file...]  creates the release with the files as assets
#
# Outputs:
#   The action result on stdout.
github() {
  action=$1
  shift
  case "$action" in
  repository) gh repo view --json nameWithOwner --jq '.nameWithOwner' ;;
  releases) gh -R "$1" release list --json tagName --limit 1000 --jq 'reverse | .[].tagName' ;;
  release) gh -R "$1" release view "$2" --json name,body,publishedAt --jq '{name, body, date: .publishedAt}' ;;
  download) gh -R "$1" release download "$2" -D "$3" ;;
  create)
    repo=$1 tag=$2 title=$3 notes=$4
    shift 5
    gh -R "$repo" release create "$tag" "$@" --title "$title" --notes "$notes"
    ;;
  esac
}

# Runs one action on GitLab. See github() for the actions.
gitlab() {
  action=$1
  shift
  case "$action" in
  repository) glab repo view --output json | jq -r '.path_with_namespace' ;;
  # --paginate can print one array per page, so they are merged before reversing.
  releases) glab api --paginate "projects/$(urlencode "$1")/releases" | jq -rs 'add | reverse | .[].tag_name' ;;
  release) glab api "projects/$(urlencode "$1")/releases/$2" | jq '{name, body: .description, date: .released_at}' ;;
  # Without an asset name, glab also downloads the source archives, which GitLab rate limits.
  download)
    glab api "projects/$(urlencode "$1")/releases/$2" | jq -j '.assets.links[] | .name + "\u0000"' |
      xargs -0 -I {} glab -R "$1" release download "$2" -n {} -D "$3"
    ;;
  create)
    repo=$1 tag=$2 title=$3 notes=$4 date=$5
    shift 5
    glab -R "$repo" release create "$tag" "$@" --name "$title" --notes "$notes" --released-at "$date"
    ;;
  esac
}

#####################################################################
#
# Releases synchronization
#
#####################################################################

# Copies one release, with its title, notes, date and assets, from the source to the target platform.
# Skips a release already on the target, and only prints its summary in dry run.
#
# Globals:
#   source_*, target_*, tmpdir, dry_run
#
# Arguments:
#   Release tag.
#
# Returns:
#   1 when the release can't be read or downloaded.
sync_release() {
  release=$1

  if "$target_platform" release "$target_repository" "$release" >/dev/null 2>&1; then
    info "Release '$release' already exist on '$target_platform'"
    return 0
  fi

  release_data=$("$source_platform" release "$source_repository" "$release") || {
    error "Failed to retrieve release '$release' from '$source_platform'"
    return 1
  }

  info "Synchronizing '$release' on '$target_platform'${dry_run:+ (dry run)}"

  assets="$tmpdir/$release"
  mkdir -p "$assets"
  "$source_platform" download "$source_repository" "$release" "$assets" || {
    error "Failed to download release '$release'"
    return 1
  }

  set -- "$assets"/*
  [ -e "$1" ] || set -- # an unmatched glob stays literal in sh
  release_title=$(printf '%s' "$release_data" | jq -r '.name')
  release_date=$(printf '%s' "$release_data" | jq -r '.date')

  if [ -n "$dry_run" ]; then
    info "Would create '$release' (title: $release_title, date: $release_date, $# assets)"
    return 0
  fi

  "$target_platform" create "$target_repository" "$release" "$release_title" \
    "$(printf '%s' "$release_data" | jq -r '.body')" \
    "$release_date" \
    "$@"
}

#####################################################################
#
# CLI arguments
#
#####################################################################

dry_run=
help=
source_spec=
target_spec=
source_platform=
target_platform=
source_repository=
target_repository=
tags=

# Checks the platform name and that its CLI is installed.
#
# Arguments:
#   Platform name.
#
# Returns:
#   2 on an unknown platform, 1 when its CLI is missing.
validate_platform() {
  case "$1" in
  github) required_command gh ;;
  gitlab) required_command glab ;;
  *) error "Invalid platform '$1'. Must be 'gitlab' or 'github'"; return 2 ;;
  esac
}

usage() {
  cat << 'EOF'
Usage: release-sync [-h] [-n] <source> <target> [tag...]

Synchronize releases from a source platform to a target platform.

Arguments:
  source  Source platform and repository (format: platform[:repository])
            - platform: 'github' or 'gitlab' (required)
            - repository: optional, defaults to the target repository, else auto-detected
            Example: github:owner/repo or gitlab

  target  Target platform and repository (format: platform[:repository])
            - platform: 'github' or 'gitlab' (required)
            - repository: optional, defaults to the source repository, else auto-detected
            Example: gitlab:group/project or github

  tag     Release tags to sync (default: all releases synced)

Examples:
  # Sync all releases from GitHub to GitLab (auto-detect repositories)
  release-sync github gitlab

  # Sync a specific version from GitHub to GitLab (auto-detect repositories)
  release-sync github gitlab v1.0.0

  # Sync several versions from GitHub to GitLab (auto-detect repositories)
  release-sync github gitlab v1.0.0 v1.1.0

  # Sync all releases with explicit repositories
  release-sync github:owner/repo gitlab:group/project

  # Sync all releases of the same repository on both platforms
  release-sync gitlab:owner/repo github

  # Sync a specific version
  release-sync github:owner/repo gitlab:group/project v1.0.0

  # Preview a sync from GitHub to GitLab
  release-sync --dry-run github gitlab

Options:
  -n, --dry-run  Run everything except the release creation, then show what would be created.
  -h, --help     Show this help.

Requirements:
  - 'gh' command (GitHub CLI) for GitHub operations
  - 'glab' command (GitLab CLI) for GitLab operations
  - 'jq' command for JSON processing
  - 'mktemp' command for temporary directory creation
  - 'xargs' command for GitLab asset downloads
EOF
}

# Parses the CLI arguments into platforms, repositories and tags.
#
# Globals:
#   dry_run, help, source_*, target_*, tags (set)
#
# Returns:
#   2 on invalid arguments.
parse_arguments() {
  while [ $# -gt 0 ]; do
    case "$1" in
    -n | --dry-run) dry_run=1; shift ;;
    -h | --help) usage; help=1; return 0 ;;
    -*) usage; error "Unknown argument '$1'."; return 2 ;;
    *)
      if [ -z "$source_spec" ]; then
        source_spec=$1
      elif [ -z "$target_spec" ]; then
        target_spec=$1
      else
        tags="${tags:+$tags }$1"
      fi
      shift
      ;;
    esac
  done

  [ -n "$target_spec" ] || {
    usage
    error "Missing required arguments."
    return 2
  }

  source_platform=${source_spec%%:*}
  case "$source_spec" in
  *:*) source_repository=${source_spec#*:} ;;
  esac

  target_platform=${target_spec%%:*}
  case "$target_spec" in
  *:*) target_repository=${target_spec#*:} ;;
  esac

  [ -n "$source_repository" ] || source_repository=$target_repository
  [ -n "$target_repository" ] || target_repository=$source_repository

  validate_platform "$source_platform" || return $?
  validate_platform "$target_platform" || return $?
}

#####################################################################
#
# Main
#
#####################################################################

tmpdir=

cleanup() {
  [ -z "$tmpdir" ] || rm -rf "$tmpdir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

required_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    error "Required command '$1' is required but wasn't found. Please install it."
    return 1
  fi
}

# Synchronizes the given tags, or every source release oldest first.
main() {
  parse_arguments "$@" || return $?
  [ -z "$help" ] || return 0
  for cmd in mktemp jq xargs; do required_command "$cmd" || return $?; done

  if [ -z "$source_repository" ]; then
    source_repository=$("$source_platform" repository) || {
      error "Failed to retrieve repository from platform CLI"
      return 1
    }
  fi
  if [ -z "$target_repository" ]; then
    target_repository=$("$target_platform" repository) || {
      error "Failed to retrieve repository from platform CLI"
      return 1
    }
  fi
  tmpdir=$(mktemp -d)

  info "Starting synchronization from '$source_platform:$source_repository' to '$target_platform:$target_repository'"

  releases=$tags
  if [ -z "$releases" ]; then
    releases=$("$source_platform" releases "$source_repository") || {
      error "Failed to retrieve releases"
      return 1
    }
  fi
  if [ -z "$releases" ]; then
    info "No releases to synchronize"
    return 0
  fi
  # shellcheck disable=SC2086 # split on purpose, a git tag can't hold whitespace
  for release in $releases; do
    sync_release "$release"
  done
}

main "$@"
