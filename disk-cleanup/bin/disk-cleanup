#!/bin/sh
# Code generated by AI (Claude Opus 5)

set -eu

# shellcheck disable=SC3040
(set -o pipefail >/dev/null 2>&1) && set -o pipefail

#####################################################################
#
# Logging
#
#####################################################################

red='\033[0;31m'
yellow='\033[0;33m'
blue='\033[0;34m'
no_color='\033[0m'

error() {
  printf "${red}ERROR${no_color} %s\n" "$1" >&2
  return 1
}

warn() {
  printf "${yellow}WARN${no_color} %s\n" "$1"
}

info() {
  printf "${blue}INFO${no_color} %s\n" "$1"
}

has() {
  command -v "$1" >/dev/null 2>&1
}

#####################################################################
#
# Progress
#
#####################################################################

# Never collides with info or warn output, which always starts with an ANSI escape.
done_marker=$(printf '\001')
clear_bar=$(printf '\r\033[K\033[A')

progress() {
  pending=" "
  total=0
  for name in $1; do
    pending="$pending$name "
    total=$((total + 1))
  done
  count=0

  drawn=
  tty=
  [ -t 2 ] && tty=1
  cols=$(stty size <&2 2>/dev/null | cut -d' ' -f2 || true)
  [ "${cols:-0}" -gt 0 ] || cols=80

  while IFS= read -r line; do
    case "$line" in
    "$done_marker"*)
      name="${line#"$done_marker"}"
      pending="${pending%%" $name "*} ${pending#*" $name "}"
      count=$((count + 1))
      ;;
    *)
      [ -z "$drawn" ] || printf '%s' "$clear_bar" >&2
      drawn=
      printf '%s\n' "$line"
      ;;
    esac
    [ -n "$tty" ] || continue

    filled=$((count * 20 / total))
    bar=
    i=0
    while [ "$i" -lt 20 ]; do
      if [ "$i" -lt "$filled" ]; then bar="$bar#"; else bar="$bar-"; fi
      i=$((i + 1))
    done
    [ -n "$drawn" ] || printf '\n' >&2
    drawn=1
    printf '\r\033[K%s' "$(printf '[%s] %d/%d waiting:%s' "$bar" "$count" "$total" "$pending" | cut -c "1-$cols")" >&2
  done
  [ -z "$drawn" ] || printf '%s' "$clear_bar" >&2
}

#####################################################################
#
# Helpers
#
#####################################################################

dir_size() {
  [ -e "$1" ] || {
    printf '0B'
    return
  }
  du -sh "$1" 2>/dev/null | cut -f1
}

empty_dir() {
  for dir in "$@"; do
    [ -d "$dir" ] || continue
    find "$dir" -mindepth 1 -delete
  done
}

newest() {
  find "$@" -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-
}

report_stale() {
  label="$1"
  stale="$2"

  if [ -z "$stale" ]; then
    info "$label: 0B"
    return
  fi

  printf '%s\n' "$stale" | while IFS= read -r dir; do
    info "$label: $(dir_size "$dir") $dir"
  done
}

clean_stale() {
  stale="$1"
  [ -n "$stale" ] || return 0

  printf '%s\n' "$stale" | while IFS= read -r dir; do
    rm -rf "$dir"
  done
}

oci_size() {
  "$1" system df --format '{{ .Type }} {{ .Size }} ({{ .Reclaimable }} reclaimable)' 2>/dev/null | \
    sed 's/^[A-Za-z ]*/\L&/; s/ ([0-9]*%)//' | \
    paste -sd ',' - | \
    sed 's/,/, /g' | \
    grep . || printf 'daemon unreachable'
}

oci_clean() {
  "$1" builder prune -f --filter "until=${oci_prune_age}" && \
    "$1" container prune -f --filter "until=${oci_prune_age}" && \
    "$1" image prune -af --filter "until=${oci_prune_age}" && \
    "$1" volume prune -f
}

#####################################################################
#
# Targets
#
#####################################################################

cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
nix_store_dir="/nix/store"

targets() {
  printf '%s\n' bun docker go golangci-lint mise mvn nix npm pip podman pre-commit terraform uv claude codex copilot vscode
}

is_target() {
  targets | grep -qx -- "$1"
}

# Runs one action of a target: probe, resolve, report, clean, dirs, and stale for version-pruned tools.
# A target ignores an action it doesn't handle.
target() {
  fn="target_$(printf '%s' "$1" | tr - _)"
  shift
  "$fn" "$@"
}

#--------------------------------------------------------------------
# bun: Bun install cache.
#--------------------------------------------------------------------

bun_cache_dir="${BUN_INSTALL_CACHE_DIR:-$HOME/.bun/install/cache}"

target_bun() {
  case "$1" in
  probe) [ -d "$bun_cache_dir" ] ;;
  report) info "bun: $(dir_size "$bun_cache_dir")" ;;
  clean) empty_dir "$bun_cache_dir" ;;
  dirs) printf '%s\n' "$bun_cache_dir" ;;
  esac
}

#--------------------------------------------------------------------
# claude: stale Claude Code versions.
#--------------------------------------------------------------------

claude_versions_dir="$data_home/claude/versions"

target_claude() {
  case "$1" in
  probe) [ -d "$claude_versions_dir" ] ;;
  stale)
    active=$(newest "$claude_versions_dir" -mindepth 1 -maxdepth 1 -type f)
    [ -n "$active" ] || return 1
    find "$claude_versions_dir" -mindepth 1 -maxdepth 1 -type f ! -path "$active"
    ;;
  report) report_stale claude "$(target_claude stale)" ;;
  clean) clean_stale "$(target_claude stale)" ;;
  dirs) printf '%s\n' "$claude_versions_dir" ;;
  esac
}

#--------------------------------------------------------------------
# codex: stale Codex releases.
#--------------------------------------------------------------------

codex_current_link="$HOME/.codex/packages/standalone/current"
codex_releases_dir="$HOME/.codex/packages/standalone/releases"

target_codex() {
  case "$1" in
  probe) [ -d "$codex_releases_dir" ] ;;
  stale)
    active=$(readlink -f "$codex_current_link" 2>/dev/null)
    [ -n "$active" ] || return 1
    find "$codex_releases_dir" -mindepth 1 -maxdepth 1 -type d ! -name "$(basename "$active")"
    ;;
  report) report_stale codex "$(target_codex stale)" ;;
  clean) clean_stale "$(target_codex stale)" ;;
  dirs) printf '%s\n' "$codex_releases_dir" ;;
  esac
}

#--------------------------------------------------------------------
# copilot: stale Copilot package versions.
#--------------------------------------------------------------------

copilot_pkg_dir="$cache_home/copilot/pkg"

target_copilot() {
  case "$1" in
  probe) [ -d "$copilot_pkg_dir" ] ;;
  stale)
    active=$(newest "$copilot_pkg_dir" -mindepth 2 -maxdepth 2 -type d)
    [ -n "$active" ] || return 1
    find "$copilot_pkg_dir" -mindepth 2 -maxdepth 2 -type d ! -path "$active"
    ;;
  report) report_stale copilot "$(target_copilot stale)" ;;
  clean) clean_stale "$(target_copilot stale)" ;;
  dirs) printf '%s\n' "$copilot_pkg_dir" ;;
  esac
}

#--------------------------------------------------------------------
# docker: build cache, containers and images older than the prune age, and unused volumes.
#--------------------------------------------------------------------

docker_data_dir="$data_home/docker"

target_docker() {
  case "$1" in
  probe) has docker ;;
  report) info "docker: $(oci_size docker)" ;;
  clean) oci_clean docker ;;
  dirs) printf '%s\n' "$docker_data_dir" ;;
  esac
}

#--------------------------------------------------------------------
# go: build cache, module cache, gopls and goimports caches.
#--------------------------------------------------------------------

go_cache_dir=
go_mod_cache_dir=
go_path_dir=
goimports_cache_dir="$cache_home/goimports"
gopls_cache_dir="$cache_home/gopls"

target_go() {
  case "$1" in
  probe) has go ;;
  resolve)
    { read -r go_cache_dir; read -r go_mod_cache_dir; read -r go_path_dir; } << EOF || true
$(go env GOCACHE GOMODCACHE GOPATH 2>/dev/null)
EOF
    ;;
  report)
    info "go: build $(dir_size "$go_cache_dir"), mod $(dir_size "$go_mod_cache_dir"), gopls $(dir_size "$gopls_cache_dir"), goimports $(dir_size "$goimports_cache_dir")"
    ;;
  clean) go clean -cache -modcache && empty_dir "$gopls_cache_dir" "$goimports_cache_dir" ;;
  dirs) printf '%s\n' "$go_cache_dir" "$go_mod_cache_dir" "$go_path_dir" "$goimports_cache_dir" "$gopls_cache_dir" ;;
  esac
}

#--------------------------------------------------------------------
# golangci-lint: golangci-lint cache.
#--------------------------------------------------------------------

golangci_lint_cache_dir="$cache_home/golangci-lint"

target_golangci_lint() {
  case "$1" in
  probe) has golangci-lint ;;
  report) info "golangci-lint: $(dir_size "$golangci_lint_cache_dir")" ;;
  clean) golangci-lint cache clean ;;
  dirs) printf '%s\n' "$golangci_lint_cache_dir" ;;
  esac
}

#--------------------------------------------------------------------
# mise: cache and unused tool versions.
#--------------------------------------------------------------------

mise_cache_dir=
mise_data_dir="$data_home/mise"

target_mise() {
  case "$1" in
  probe) has mise ;;
  resolve) mise_cache_dir=$(mise cache path 2>/dev/null || true) ;;
  report) info "mise: $(dir_size "$mise_cache_dir")" ;;
  clean) mise cache clear && mise prune -y ;;
  dirs) printf '%s\n' "$mise_cache_dir" "$mise_data_dir" ;;
  esac
}

#--------------------------------------------------------------------
# mvn: local Maven repository.
#--------------------------------------------------------------------

maven_repository_dir="$HOME/.m2/repository"

target_mvn() {
  case "$1" in
  probe) [ -d "$maven_repository_dir" ] ;;
  report) info "mvn: $(dir_size "$maven_repository_dir")" ;;
  clean) empty_dir "$maven_repository_dir" ;;
  dirs) printf '%s\n' "$maven_repository_dir" ;;
  esac
}

#--------------------------------------------------------------------
# nix: old generations and unreachable Nix store paths.
#--------------------------------------------------------------------

target_nix() {
  case "$1" in
  probe) has nix ;;
  report) info "nix: $(dir_size "$nix_store_dir")" ;;
  clean) nix-collect-garbage --quiet -d ;;
  dirs) printf '%s\n' "$nix_store_dir/*" ;;
  esac
}

#--------------------------------------------------------------------
# npm: npm cache, npx cache and node-gyp cache.
#--------------------------------------------------------------------

npm_cache_dir=
node_gyp_cache_dir="$cache_home/node-gyp"

target_npm() {
  case "$1" in
  probe) has npm ;;
  resolve) npm_cache_dir=$(npm config get cache 2>/dev/null || true) ;;
  report) info "npm: cache $(dir_size "$npm_cache_dir"), node-gyp $(dir_size "$node_gyp_cache_dir")" ;;
  clean) npm cache clean --force && empty_dir "$npm_cache_dir/_npx" "$node_gyp_cache_dir" ;;
  dirs) printf '%s\n' "$npm_cache_dir" "$node_gyp_cache_dir" ;;
  esac
}

#--------------------------------------------------------------------
# pip: pip cache.
#--------------------------------------------------------------------

pip_cache_dir=

target_pip() {
  case "$1" in
  probe) has pip ;;
  resolve) pip_cache_dir=$(pip cache dir 2>/dev/null || true) ;;
  report) info "pip: $(dir_size "$pip_cache_dir")" ;;
  clean) pip cache purge ;;
  dirs) printf '%s\n' "$pip_cache_dir" ;;
  esac
}

