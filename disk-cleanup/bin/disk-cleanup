#!/bin/sh

set -e

# shellcheck disable=SC3040
(set -o pipefail >/dev/null 2>&1) && set -o pipefail

#####################################################################
#
# Logging
#
#####################################################################

red='\033[0;31m'
yellow='\033[0;33m'
blue='\033[0;34m'
no_color='\033[0m'

error() {
  printf "${red}ERROR${no_color} %s\n" "$1" >&2
  return 1
}

warn() {
  printf "${yellow}WARN${no_color} %s\n" "$1"
}

info() {
  printf "${blue}INFO${no_color} %s\n" "$1"
}

#####################################################################
#
# Paths
#
#####################################################################

cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"

claude_dir="$data_home/claude"
claude_versions_dir="$claude_dir/versions"
codex_current_link="$HOME/.codex/packages/standalone/current"
codex_releases_dir="$HOME/.codex/packages/standalone/releases"
copilot_cache_dir="$cache_home/copilot"
copilot_pkg_dir="$copilot_cache_dir/pkg"
vscode_server_dir="$HOME/.vscode-server"

bun_cache_dir="${BUN_INSTALL_CACHE_DIR:-$HOME/.bun/install/cache}"
docker_data_dir="$data_home/docker"
goimports_cache_dir="$cache_home/goimports"
golangci_lint_cache_dir="$cache_home/golangci-lint"
gopls_cache_dir="$cache_home/gopls"
maven_repository_dir="$HOME/.m2/repository"
mise_data_dir="$data_home/mise"
nix_store_dir="/nix/store"
node_gyp_cache_dir="$cache_home/node-gyp"
podman_data_dir="$data_home/containers"
pre_commit_cache_dir="$cache_home/pre-commit"
terraform_cache_dir="$cache_home/terraform"
terraform_plugin_cache_dir="${TF_PLUGIN_CACHE_DIR:-$terraform_cache_dir/plugin-cache}"
uv_cache_dir="$cache_home/uv"

disk_warn="${DC_WARN_LEVEL:-80}"
cache_threshold="${DC_CACHE_THRESHOLD:-500M}"

# Each lookup spawns the tool runtime (node, python), so resolve once and reuse.
resolve_tool_dirs() {
  if target_probe go; then
    { read -r go_cache_dir; read -r go_mod_cache_dir; read -r go_path_dir; } <<EOF || true
$(go env GOCACHE GOMODCACHE GOPATH 2>/dev/null)
EOF
  fi
  target_probe mise && mise_cache_dir=$(mise cache path 2>/dev/null || true)
  target_probe npm && npm_cache_dir=$(npm config get cache 2>/dev/null || true)
  target_probe pip && pip_cache_dir=$(pip cache dir 2>/dev/null || true)
  return 0
}

#####################################################################
#
# Disk usage
#
#####################################################################

disk_report() {
  df -hP / "$HOME" 2>/dev/null | awk 'NR > 1 && !seen[$1]++ { print $6, $5 + 0, $4 }' | while read -r mount used free; do
    if [ "$used" -ge "$disk_warn" ]; then
      warn "disk: $mount ${used}% used, $free free"
    else
      info "disk: $mount ${used}% used, $free free"
    fi
  done || true
}

dir_size() {
  [ -e "$1" ] || {
    printf '0B'
    return
  }
  du -sh "$1" 2>/dev/null | cut -f1
}

#####################################################################
#
# Targets
#
#####################################################################

targets() {
  printf '%s\n' bun docker go golangci-lint mise mvn nix npm pip podman pre-commit terraform uv claude codex copilot vscode
}

target_probe() {
  case "$1" in
  bun) [ -d "$bun_cache_dir" ] ;;
  claude) [ -d "$claude_versions_dir" ] ;;
  codex) [ -d "$codex_releases_dir" ] ;;
  copilot) [ -d "$copilot_pkg_dir" ] ;;
  mvn) [ -d "$maven_repository_dir" ] ;;
  terraform) [ -d "$terraform_plugin_cache_dir" ] ;;
  vscode) [ -d "$vscode_server_dir" ] ;;
  *) command -v "$1" >/dev/null 2>&1 ;;
  esac
}

target_size() {
  case "$1" in
  bun) dir_size "$bun_cache_dir" ;;
  docker)
    docker system df --format '{{ .Type }} {{ .Size }} ({{ .Reclaimable }} reclaimable)' 2>/dev/null | \
      sed 's/^[A-Za-z ]*/\L&/; s/ ([0-9]*%)//' | \
      paste -sd ',' - | \
      sed 's/,/, /g' | \
      grep . || printf 'daemon unreachable'
    ;;
  podman)
    podman system df --format '{{ .Type }} {{ .Size }} ({{ .Reclaimable }} reclaimable)' 2>/dev/null | \
      sed 's/^[A-Za-z ]*/\L&/; s/ ([0-9]*%)//' | \
      paste -sd ',' - | \
      sed 's/,/, /g' | \
      grep . || printf 'daemon unreachable'
    ;;
  go)
    printf 'build %s, mod %s, gopls %s, goimports %s' \
      "$(dir_size "$go_cache_dir")" \
      "$(dir_size "$go_mod_cache_dir")" \
      "$(dir_size "$gopls_cache_dir")" \
      "$(dir_size "$goimports_cache_dir")"
    ;;
  golangci-lint) dir_size "$golangci_lint_cache_dir" ;;
  mise) dir_size "$mise_cache_dir" ;;
  mvn) dir_size "$maven_repository_dir" ;;
  nix) dir_size "$nix_store_dir" ;;
  npm) printf 'cache %s, node-gyp %s' "$(dir_size "$npm_cache_dir")" "$(dir_size "$node_gyp_cache_dir")" ;;
  pip) dir_size "$pip_cache_dir" ;;
  pre-commit) dir_size "$pre_commit_cache_dir" ;;
  terraform) dir_size "$terraform_plugin_cache_dir" ;;
  uv) dir_size "$uv_cache_dir" ;;
  esac
}

stale_dirs() {
  case "$1" in
  claude)
    active=$(find "$claude_versions_dir" -mindepth 1 -maxdepth 1 -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
    [ -n "$active" ] || return 1
    find "$claude_versions_dir" -mindepth 1 -maxdepth 1 -type f ! -path "$active"
    ;;
  codex)
    active=$(readlink -f "$codex_current_link" 2>/dev/null)
    [ -n "$active" ] || return 1
    find "$codex_releases_dir" -mindepth 1 -maxdepth 1 -type d ! -name "$(basename "$active")"
    ;;
  copilot)
    active=$(find "$copilot_pkg_dir" -mindepth 2 -maxdepth 2 -type d -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
    [ -n "$active" ] || return 1
    find "$copilot_pkg_dir" -mindepth 2 -maxdepth 2 -type d ! -path "$active"
    ;;
  vscode)
    active=$(find "$vscode_server_dir" -maxdepth 1 -type f -name 'code-*' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)
    [ -n "$active" ] || return 1
    hash=$(basename "$active" | sed 's/^code-//')
    for dir in "$vscode_server_dir"/code-* "$vscode_server_dir"/cli/servers/Stable-*; do
      [ -e "$dir" ] || continue
      case "$dir" in
      *"$hash") ;;
      *) printf '%s\n' "$dir" ;;
      esac
    done
    ;;
  esac
}

report_stale() {
  label="$1"
  stale="$2"

  if [ -z "$stale" ]; then
    info "$label: 0B"
    return
  fi

  printf '%s\n' "$stale" | while IFS= read -r dir; do
    info "$label: $(dir_size "$dir") $dir"
  done
}

target_report() {
  case "$1" in
  claude | codex | copilot | vscode) report_stale "$1" "$(stale_dirs "$1")" ;;
  *) info "$1: $(target_size "$1")" ;;
  esac
}

clean_stale() {
  stale="$1"
  [ -n "$stale" ] || return 0

  printf '%s\n' "$stale" | while IFS= read -r dir; do
    rm -rf "$dir"
  done
}

empty_dir() {
  for dir in "$@"; do
    [ -d "$dir" ] || continue
    find "$dir" -mindepth 1 -delete
  done
}

target_clean() {
  case "$1" in
  bun) empty_dir "$bun_cache_dir" ;;
  docker)
    docker builder prune -f --filter 'until=120h' && \
      docker container prune -f --filter 'until=120h' && \
      docker image prune -af --filter 'until=120h' && \
      docker volume prune -f
    ;;
  go) go clean -cache -modcache && empty_dir "$gopls_cache_dir" "$goimports_cache_dir" ;;
  golangci-lint) golangci-lint cache clean ;;
  mise) mise cache clear && mise prune -y ;;
  mvn) empty_dir "$maven_repository_dir" ;;
  nix) nix-collect-garbage --quiet -d ;;
  npm) npm cache clean --force && empty_dir "$npm_cache_dir/_npx" "$node_gyp_cache_dir" ;;
  pip) pip cache purge ;;
  podman)
    podman builder prune -f --filter 'until=120h' && \
      podman container prune -f --filter 'until=120h' && \
      podman image prune -af --filter 'until=120h' && \
      podman volume prune -f
    ;;
  pre-commit) pre-commit clean ;;
  terraform) empty_dir "$terraform_plugin_cache_dir" ;;
  uv) uv cache clean ;;
  claude | codex | copilot | vscode) clean_stale "$(stale_dirs "$1")" ;;
  esac
}

#####################################################################
#
# Uncovered directories (no target owns them)
#
#####################################################################

covered_dirs() {
  printf '%s\n' \
    "$bun_cache_dir" \
    "$claude_dir" \
    "$copilot_cache_dir" \
    "$docker_data_dir" \
    "$go_cache_dir" \
    "$go_path_dir" \
    "$goimports_cache_dir" \
    "$golangci_lint_cache_dir" \
    "$gopls_cache_dir" \
    "$mise_cache_dir" \
    "$mise_data_dir" \
    "$nix_store_dir/*" \
    "$node_gyp_cache_dir" \
    "$npm_cache_dir" \
    "$pip_cache_dir" \
    "$podman_data_dir" \
    "$pre_commit_cache_dir" \
    "$terraform_cache_dir" \
    "$uv_cache_dir"
}

uncovered_report() {
  exclude_file=$(mktemp)
  covered_dirs > "$exclude_file"

  find "$cache_home" "$data_home" "$nix_store_dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null \
    | xargs -0 du -xsh --threshold="${cache_threshold}" --exclude-from="$exclude_file" 2>/dev/null \
    | sort -rh \
    | while IFS="$(printf '\t')" read -r size dir; do
      info "uncovered: $size $dir"
    done || true

  rm -f "$exclude_file"
}

#####################################################################
#
# CLI arguments
#
#####################################################################

run=
all=
help=
selected=

usage() {
  cat << 'EOF'
Usage: disk-cleanup [-w <percent>] [-t <size>] [--run [--all | --<tool> ...]]

Reclaim disk space by deleting dev-tool caches via their own clean commands and stale tools version directories.
Not installed tools are skipped during checks and run.

When no provided flags, it only report filesystem usage, size of every detected target
and any directory above 500M under $XDG_CACHE_HOME, $XDG_DATA_HOME or /nix/store that no known target cleans.

Use DC_WARN_LEVEL or -w to set the disk usage percent that triggers a warning (default 80%).
Use DC_CACHE_THRESHOLD or -t to set the uncovered directory size floor (default 500M).

Options:
  -r, --run                     Required to clean anything. Alone (no -a, --all or --<tool>), cleans nothing.
  -a, --all                     With --run, clean every detected target.
  -h, --help                    Show this help.
  -w, --warn-level <percent>    Disk usage percent that triggers a warning. Overrides DC_WARN_LEVEL.
  -t, --cache-threshold <size>  Uncovered directory size floor. Overrides DC_CACHE_THRESHOLD.
  --bun                         Cleans Bun install cache.
  --docker                      Cleans build cache, containers, images, volumes older than 120h.
  --go                          Cleans build cache, module cache, gopls and goimports caches.
  --golangci-lint               Cleans golangci-lint cache.
  --mise                        Cleans cache and unused tool versions.
  --mvn                         Cleans local Maven repository.
  --nix                         Cleans old generations and unreachable Nix store paths.
  --npm                         Cleans npm cache, npx cache and node-gyp cache.
  --pip                         Cleans pip cache.
  --podman                      Cleans build cache, containers, images, volumes older than 120h.
  --pre-commit                  Cleans pre-commit cache.
  --terraform                   Cleans Terraform plugin cache.
  --uv                          Cleans uv cache.
  --claude                      Cleans stale Claude Code versions.
  --codex                       Cleans stale Codex releases.
  --copilot                     Cleans stale Copilot package versions.
  --vscode                      Cleans stale VSCode Server versions.

--<tool> and --all select cleanup targets, however they require --run to be applied and have no effect on the dry-run report.
EOF
}

parse_arguments() {
  while [ $# -gt 0 ]; do
    case "$1" in
    -r | --run) run=1; shift ;;
    -a | --all) all=1; shift ;;
    -h | --help) usage; help=1; return 0 ;;
    -w=* | --warn-level=*) disk_warn="${1#*=}"; shift ;;
    -w | --warn-level) disk_warn="$2"; shift 2 ;;
    -t=* | --cache-threshold=*) cache_threshold="${1#*=}"; shift ;;
    -t | --cache-threshold) cache_threshold="$2"; shift 2 ;;
    --bun|--claude|--codex|--copilot|--docker|--go|--golangci-lint|--mise|--mvn|--nix|--npm|--pip|--podman|--pre-commit|--terraform|--uv|--vscode)
      selected="$selected ${1#--}"
      shift
      ;;
    *) usage; error "Unknown argument '$1'."; return 2 ;;
    esac
  done

  if { [ -n "$selected" ] || [ -n "$all" ]; } && [ -z "$run" ]; then
    usage
    error "Tool selection flags require '--run'."
    return 2
  fi
}

#####################################################################
#
# Main
#
#####################################################################

required_gnu() {
  "$1" --version 2>/dev/null | grep -q GNU || error "GNU $1 is required (coreutils/findutils). Please install it."
}

main() {
  parse_arguments "$@" || return $?
  [ -z "$help" ] || return 0
  for cmd in du find sed sort; do required_gnu "$cmd" || return $?; done

  resolve_tool_dirs
  disk_report

  detected=""
  for name in $(targets); do
    target_probe "$name" && detected="$detected $name"
  done

  for name in $detected; do
    target_report "$name" &
  done
  uncovered_report &
  wait

  [ -n "$run" ] || { printf '\nRerun with --run --<tool> (or --all) to clean a listed target\n'; return 0; }
  [ -z "$all" ] || selected="$detected"

  failed=
  for name in $selected; do
    case " $detected " in
    *" $name "*) ;;
    *) info "$name: not detected, skipped"; continue ;;
    esac
    if target_clean "$name"; then info "$name: cleaned"; else error "$name: cleanup failed" || failed=1; fi
  done
  [ -z "$failed" ]
}

main "$@"
