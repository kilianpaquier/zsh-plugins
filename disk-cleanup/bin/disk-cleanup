#--------------------------------------------------------------------
# uv: uv cache.
#--------------------------------------------------------------------

uv_cache_dir="$cache_home/uv"

target_uv() {
  case "$1" in
  probe) has uv ;;
  report) info "uv: $(dir_size "$uv_cache_dir")" ;;
  clean) uv cache clean ;;
  dirs) printf '%s\n' "$uv_cache_dir" ;;
  esac
}

#--------------------------------------------------------------------
# vscode: stale VSCode Server versions.
#--------------------------------------------------------------------

vscode_server_dir="$HOME/.vscode-server"

target_vscode() {
  case "$1" in
  probe) [ -d "$vscode_server_dir" ] ;;
  stale)
    active=$(newest "$vscode_server_dir" -maxdepth 1 -type f -name 'code-*')
    [ -n "$active" ] || return 1
    hash=$(basename "$active" | sed 's/^code-//')
    for dir in "$vscode_server_dir"/code-* "$vscode_server_dir"/cli/servers/Stable-*; do
      [ -e "$dir" ] || continue
      case "$dir" in
      *"$hash") ;;
      *) printf '%s\n' "$dir" ;;
      esac
    done
    ;;
  report) report_stale vscode "$(target_vscode stale)" ;;
  clean) clean_stale "$(target_vscode stale)" ;;
  dirs) printf '%s\n' "$vscode_server_dir" ;;
  esac
}

#####################################################################
#
# Reports
#
#####################################################################

disk_report() {
  df -hP / "$HOME" 2>/dev/null | awk 'NR > 1 && !seen[$1]++ { print $6, $5 + 0, $4 }' | while read -r mount used free; do
    if [ "$used" -ge "$disk_warn" ]; then
      warn "disk: $mount ${used}% used, $free free"
    else
      info "disk: $mount ${used}% used, $free free"
    fi
  done || true
}

# Directories above the threshold that no detected target owns.
uncovered_report() {
  for covered in $1; do target "$covered" dirs; done > "$exclude_file"

  find "$cache_home" "$data_home" "$nix_store_dir" -mindepth 1 -maxdepth 1 -print0 2>/dev/null \
    | xargs -0 du -xsh --threshold="${cache_threshold}" --exclude-from="$exclude_file" 2>/dev/null \
    | sort -rh \
    | while IFS="$(printf '\t')" read -r size dir; do
      info "uncovered: $size $dir"
    done || true
}

report_targets() {
  jobs="$1"
  [ -n "$fast" ] || jobs="$jobs uncovered"
  {
    for job in $jobs; do
      {
        case "$job" in
        uncovered) uncovered_report "$1" ;;
        *) target "$job" report ;;
        esac || true
        printf '%s%s\n' "$done_marker" "$job"
      } &
    done
    wait
  } | progress "$jobs"
}

#####################################################################
#
# CLI arguments
#
#####################################################################

run=
all=
fast=
help=
selected=

disk_warn="${DC_WARN_LEVEL:-80}"
cache_threshold="${DC_CACHE_THRESHOLD:-500M}"
oci_prune_age="${DC_OCI_PRUNE_AGE:-120h}"

usage() {
  cat << 'EOF'
Usage: disk-cleanup [-h] [-f] [-w <percent>] [-t <size>] [-p <duration>] [--run (--all | --<tool> ...)]

Free disk space taken by dev tool caches and old tool versions.
Without --run nothing is deleted. It shows disk usage, the space each installed tool takes,
and large directories no tool cleans.

Examples:
  # See what can be cleaned
  disk-cleanup

  # Clean Go and npm caches
  disk-cleanup --run --go --npm

  # Clean every installed tool
  disk-cleanup --run --all

Options:
  -r, --run                       Delete for real. Needs --all or at least one --<tool>.
  -a, --all                       Clean every installed tool.
  -f, --fast                      Skip the large directories scan (slowest step).
  -w, --warn-level <percent>      Warn above this disk usage (default 80, or DC_WARN_LEVEL).
  -t, --cache-threshold <size>    Show unowned directories above this size (default 500M, or DC_CACHE_THRESHOLD).
  -p, --oci-prune-age <duration>  Keep docker and podman data newer than this (default 120h, or DC_OCI_PRUNE_AGE).
  -h, --help                      Show this help.

Tools:
  --bun            Bun install cache.
  --docker         Build cache, containers and images older than the prune age, and unused volumes.
  --go             Build, module, gopls and goimports caches.
  --golangci-lint  golangci-lint cache.
  --mise           Cache and unused tool versions.
  --mvn            Whole local Maven repository (dependencies are downloaded again).
  --nix            Old generations and unreachable store paths.
  --npm            npm, npx and node-gyp caches.
  --pip            pip cache.
  --podman         Build cache, containers and images older than the prune age, and unused volumes.
  --pre-commit     pre-commit cache.
  --terraform      Terraform plugin cache.
  --uv             uv cache.
  --claude         Old Claude Code versions.
  --codex          Old Codex releases.
  --copilot        Old Copilot package versions.
  --vscode         Old VSCode Server versions.
EOF
}

value_required() {
  [ $# -ge 2 ] || {
    usage
    error "Missing value for '$1'."
    return 2
  }
}

parse_arguments() {
  while [ $# -gt 0 ]; do
    case "$1" in
    -r | --run) run=1; shift ;;
    -a | --all) all=1; shift ;;
    -f | --fast) fast=1; shift ;;
    -h | --help) usage; help=1; return 0 ;;
    -w=* | --warn-level=*) disk_warn="${1#*=}"; shift ;;
    -w | --warn-level) value_required "$@" || return $?; disk_warn="$2"; shift 2 ;;
    -t=* | --cache-threshold=*) cache_threshold="${1#*=}"; shift ;;
    -t | --cache-threshold) value_required "$@" || return $?; cache_threshold="$2"; shift 2 ;;
    -p=* | --oci-prune-age=*) oci_prune_age="${1#*=}"; shift ;;
    -p | --oci-prune-age) value_required "$@" || return $?; oci_prune_age="$2"; shift 2 ;;
    --*)
      is_target "${1#--}" || {
        usage
        error "Unknown argument '$1'."
        return 2
      }
      selected="$selected ${1#--}"
      shift
      ;;
    *) usage; error "Unknown argument '$1'."; return 2 ;;
    esac
  done

  if { [ -n "$selected" ] || [ -n "$all" ]; } && [ -z "$run" ]; then
    usage
    error "Tool selection flags require '--run'."
    return 2
  fi
}

#####################################################################
#
# Main
#
#####################################################################

exclude_file=

cleanup() {
  [ -z "$exclude_file" ] || rm -f "$exclude_file"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

required_command() {
  if ! has "$1"; then
    error "Required command '$1' is required but wasn't found. Please install it."
    return 1
  fi
}

detect_targets() {
  for name in $(targets); do
    if target "$name" probe; then printf ' %s' "$name"; fi
  done
}

clean_targets() {
  detected="$1"
  failed=
  for name in $2; do
    case " $detected " in
    *" $name "*) ;;
    *) info "$name: not detected, skipped"; continue ;;
    esac
    if target "$name" clean; then info "$name: cleaned"; else error "$name: cleanup failed" || failed=1; fi
  done
  [ -z "$failed" ]
}

main() {
  parse_arguments "$@" || return $?
  [ -z "$help" ] || return 0
  for cmd in du find sed sort; do required_command "$cmd" || return $?; done

  disk_report
  detected=$(detect_targets)
  # Each lookup spawns the tool runtime (node, python), so resolve once and reuse.
  for name in $detected; do target "$name" resolve; done
  [ -n "$fast" ] || exclude_file=$(mktemp)
  report_targets "$detected"

  [ -n "$run" ] || { printf '\nRerun with --run --<tool> (or --all) to clean a listed target\n'; return 0; }
  [ -z "$all" ] || selected="$detected"
  clean_targets "$detected" "$selected"
}

main "$@"
